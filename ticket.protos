syntax = "proto3";
option csharp_namespace = "Shared.gRPC";

service TicketService {
  rpc ReserveTickets (ReserveRequest) returns (ReserveResponse);
}

message ReserveRequest {
  string event_id = 1;
  string ticket_type = 2;
  int32 quantity = 3;
}

message ReserveResponse {
  bool success = 1;
  string message = 2;
}